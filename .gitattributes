# Auto detect text files and perform LF normalization
* text=auto

# PHP and web source files
*.php text eol=lf
*.css text eol=lf
*.js text eol=lf
*.json text eol=lf
*.md text eol=lf
*.txt text eol=lf

# Binary files
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.mo binary
*.woff binary
*.woff2 binary
*.ttf binary
*.eot binary

# Export ignore for clean distribution packages
/.git* export-ignore
/.gitignore export-ignore
/.gitattributes export-ignore
/scratch export-ignore
/extracted_strings.txt export-ignore
